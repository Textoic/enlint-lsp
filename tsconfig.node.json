{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "tsBuildInfoFile": "dist/node/.tsbuildinfo"
  },
  "references": [{ "path": "./tsconfig.src.json" }],
  "include": ["src/node/**/*.ts"]
}
