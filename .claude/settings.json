{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/lint-gate.mjs\"; if [ -f \"$H\" ]; then node \"$H\"; else exit 0; fi",
            "timeout": 60,
            "statusMessage": "Checking house rules..."
          }
        ]
      }
    ]
  }
}
